From 4914b8ee41484239fd672228df877b7f4f955415 Mon Sep 17 00:00:00 2001
From: Elliot Ward <elliot.ward@digital.justice.gov.uk>
Date: Tue, 10 Nov 2026 14:55:09 +0000
Subject: [PATCH 1/3] #3596491: override propertyDefinitions() to remove
 resolvable_uri from ComputedBreadcrumbsLinkItem. This was introduced in
 Drupal 11.4 and breaks relative urls, and is redundant for non-relative urls.

---
 .../Field/FieldType/ComputedBreadcrumbsLinkItem.php    | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/Plugin/Field/FieldType/ComputedBreadcrumbsLinkItem.php b/src/Plugin/Field/FieldType/ComputedBreadcrumbsLinkItem.php
index 72b7874..07bec85 100644
--- a/src/Plugin/Field/FieldType/ComputedBreadcrumbsLinkItem.php
+++ b/src/Plugin/Field/FieldType/ComputedBreadcrumbsLinkItem.php
@@ -2,6 +2,7 @@
 
 namespace Drupal\computed_breadcrumbs\Plugin\Field\FieldType;
 
+use Drupal\Core\Field\FieldStorageDefinitionInterface;
 use Drupal\link\Plugin\Field\FieldType\LinkItem;
 
 /**
@@ -22,5 +23,12 @@ use Drupal\link\Plugin\Field\FieldType\LinkItem;
  * )
  */
 class ComputedBreadcrumbsLinkItem extends LinkItem {
-
+    /**
+     * {@inheritdoc}
+     */
+    public static function propertyDefinitions(FieldStorageDefinitionInterface $field_definition) {
+        $propertyDefinitions = parent::propertyDefinitions($field_definition);
+        unset($propertyDefinitions['resolvable_uri']);
+        return $propertyDefinitions;
+    }
 }
-- 
GitLab


